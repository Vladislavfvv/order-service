<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="001-create-orders-table" author="vlad">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="orders" schemaName="public"/>
            </not>
        </preConditions>

        <comment>Создание таблицы orders для хранения заказов</comment>

        <createTable tableName="orders" schemaName="public">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="creation_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Индекс для быстрого поиска по user_id -->
        <createIndex tableName="orders" indexName="idx_orders_user_id" schemaName="public">
            <column name="user_id"/>
        </createIndex>

        <!-- Индекс для поиска по статусу -->
        <createIndex tableName="orders" indexName="idx_orders_status" schemaName="public">
            <column name="status"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>

