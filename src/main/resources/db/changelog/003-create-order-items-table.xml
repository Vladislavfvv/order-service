<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="003-create-order-items-table" author="vlad">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="order_items" schemaName="public"/>
            </not>
        </preConditions>

        <comment>Создание таблицы order_items для связи заказов и товаров</comment>

        <createTable tableName="order_items" schemaName="public">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="item_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Внешний ключ для связи с таблицей orders -->
        <addForeignKeyConstraint baseTableName="order_items"
                                 baseTableSchemaName="public"
                                 baseColumnNames="order_id"
                                 referencedTableName="orders"
                                 referencedTableSchemaName="public"
                                 referencedColumnNames="id"
                                 constraintName="fk_orderitems_orders"/>

        <!-- Внешний ключ для связи с таблицей items -->
        <addForeignKeyConstraint baseTableName="order_items"
                                 baseTableSchemaName="public"
                                 baseColumnNames="item_id"
                                 referencedTableName="items"
                                 referencedTableSchemaName="public"
                                 referencedColumnNames="id"
                                 constraintName="fk_orderitems_items"/>

        <!-- Индекс для быстрого поиска по order_id -->
        <createIndex tableName="order_items" indexName="idx_order_items_order_id" schemaName="public">
            <column name="order_id"/>
        </createIndex>

        <!-- Индекс для быстрого поиска по item_id -->
        <createIndex tableName="order_items" indexName="idx_order_items_item_id" schemaName="public">
            <column name="item_id"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>

