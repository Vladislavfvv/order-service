<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                       https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="002-create-items-table" author="vlad">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="items" schemaName="public"/>
            </not>
        </preConditions>

        <comment>Создание таблицы items для хранения товаров</comment>

        <createTable tableName="items" schemaName="public">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Индекс для быстрого поиска по названию товара -->
        <createIndex tableName="items" indexName="idx_items_name" schemaName="public">
            <column name="name"/>
        </createIndex>

    </changeSet>
</databaseChangeLog>

